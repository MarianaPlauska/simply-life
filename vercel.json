{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "npm install --no-audit --no-fund && cd frontend && npm install --no-audit --no-fund",
  "framework": "vite",
  "github": {
    "enabled": true,
    "silent": false,
    "autoJobCancelation": true
  },
  "build": {
    "env": {
      "VITE_SUPABASE_URL": "https://zuxkqmooxvnulgllduhr.supabase.co",
      "VITE_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inp1eGtxbW9veHZudWxnbGxkdWhyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzYxNjkwMTQsImV4cCI6MjA5MTc0NTAxNH0.e2pB4ibInNosWSUvYoxT5NJpE1WlrIVbrGTpoB811i8"
    }
  },
  "rewrites": [
    { "source": "/api/webhook-ingest", "destination": "/api/webhooks/m2m" },
    { "source": "/api/push-subscribe", "destination": "/api/webhooks/push-subscribe" },
    { "source": "/api/push-test", "destination": "/api/webhooks/push-test" },
    { "source": "/api/demo-login-reset", "destination": "/api/demo/login-reset" },
    { "source": "/api/morning-brief", "destination": "/api/axel/morning-brief" },
    { "source": "/api/orchestrate-tasks", "destination": "/api/axel/orchestrate-tasks" },
    { "source": "/api/task-estimate", "destination": "/api/axel/task-estimate" },
    { "source": "/api/ingest-email", "destination": "/api/axel/ingest-email" },
    { "source": "/api/ingest-tasks", "destination": "/api/axel/ingest-tasks" },
    { "source": "/api/estimate-protein", "destination": "/api/axel/estimate-protein" },
    { "source": "/api/process-event", "destination": "/api/axel/process-event" },
    { "source": "/api/finance-coach", "destination": "/api/axel/finance-coach" },
    { "source": "/api/finance-purchase-check", "destination": "/api/axel/finance-purchase-check" },
    { "source": "/api/fetch-news", "destination": "/api/axel/fetch-news" },
    { "source": "/api/generate-greeting", "destination": "/api/axel/generate-greeting" },
    { "source": "/api/today-verdict", "destination": "/api/axel/today-verdict" },
    { "source": "/api/weekly-digest-test", "destination": "/api/axel/weekly-digest-test" },
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 9 * * *"
    }
  ]
}
