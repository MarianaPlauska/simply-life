# Copie para .env.local na raiz (nunca commite chaves reais)
# Usado pelas rotas /api/* no Vercel e em `npx vercel dev`

# === IA (servidor apenas — NÃO use prefixo VITE_ em produção) ===
# Groq — gratuito: https://console.groq.com/keys
GROQ_API_KEY=gsk_sua_chave_aqui

# Supabase — servidor (Gmail IMAP, webhooks, propostas de prazo)
# Dashboard → Settings → API
VITE_SUPABASE_URL=https://zuxkqmooxvnulgllduhr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Cron automático de e-mail (opcional)
CRON_SECRET=

# Web Push PWA (boletos no celular) — gere com: node scripts/generate-vapid.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@simply.life

# === Gmail gratuito: NÃO precisa das variáveis abaixo ===
# Use senha de app em Configurações → Gmail — plano gratuito

# === Opcional — OAuth Google Cloud (Calendar + Gmail API) ===
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://seu-dominio.vercel.app/google-callback

# GEMINI_API_KEY=

# CORS em produção — origens permitidas (vírgula). Ex.: https://seu-app.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=
