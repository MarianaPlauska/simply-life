# Copie para .env.local na raiz do projeto (nunca commite a chave real)
# Usado pelas rotas /api/* no Vercel e em `npx vercel dev`

# Groq — priorização em lote no Kanban (grátis, sem cartão)
# Crie em: https://console.groq.com/keys
GROQ_API_KEY=gsk_sua_chave_aqui

# Opcional — Gemini como alternativa (Groq tem prioridade se ambos existirem)
# GEMINI_API_KEY=

# Supabase (admin — só servidor, se usar webhooks)
# SUPABASE_SERVICE_ROLE_KEY=
