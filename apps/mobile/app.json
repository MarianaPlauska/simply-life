{
  "expo": {
    "name": "SunFy",
    "slug": "simply-life",
    "version": "1.1.0",
    "orientation": "portrait",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "marianaplauska",
    "extra": {
      "eas": {
        "projectId": "71a668d6-d410-4b6f-83c5-2d58723bd183"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/71a668d6-d410-4b6f-83c5-2d58723bd183"
    },
    "scheme": "simplylife",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.sunfy"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1F3A3D"
      },
      "package": "app.sunfy",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#1F3A3D",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#1F3A3D"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O SunFy usa a câmera só para ler o código de barras dos alimentos.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E8734A",
          "defaultChannel": "default"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "SunFyHoje",
              "label": "SunFy - Hoje",
              "description": "Água, humor e próxima tarefa sem abrir o app",
              "minWidth": "250dp",
              "minHeight": "160dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
