EXPO_PUBLIC_SUPABASE_URL=https://zuxkqmooxvnulgllduhr.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Opcional: origem canônica (produção). Em web local o app usa window.location.origin.
# EXPO_PUBLIC_APP_URL=https://simply-life.app
#
# Google login: cadastre no Supabase Redirect URLs a origem+porta atuais, ex.:
#   http://localhost:8082/auth/callback
#   http://localhost:8083/auth/callback
# API Vercel (IA do Axel, push). O app no celular (Expo Go/APK) é só cliente:
# a IA roda na Vercel, onde ficam as chaves GROQ/GEMINI.
# Use a URL de produção. "localhost" no celular é o próprio aparelho e não funciona.
# Sem esta variável: dev tenta `vercel dev` (:3000) e cai para produção sozinho.
EXPO_PUBLIC_API_URL=https://simply-life.vercel.app
# Opcional — EAS projectId (dev build). Expo Go costuma funcionar sem.
EXPO_PUBLIC_EAS_PROJECT_ID=
