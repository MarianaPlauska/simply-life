{
  "name": "@simply-life/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "node ./scripts/patch-expo-router-ctx.js",
    "start": "node ./scripts/patch-expo-router-ctx.js && expo start",
    "android": "node ./scripts/patch-expo-router-ctx.js && expo start --android",
    "ios": "node ./scripts/patch-expo-router-ctx.js && expo start --ios",
    "web": "node ./scripts/patch-expo-router-ctx.js && expo start --web --port 8082",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo/metro-runtime": "~4.0.1",
    "@expo/vector-icons": "14.0.4",
    "@opentelemetry/api": "^1.9.1",
    "@simply-life/shared": "*",
    "@simply-life/ui-tokens": "*",
    "@supabase/supabase-js": "^2.45.4",
    "babel-preset-expo": "~12.0.0",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.0",
    "expo-device": "~7.0.3",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.1",
    "expo-linear-gradient": "~14.0.2",
    "expo-linking": "~7.0.0",
    "expo-location": "~18.0.10",
    "expo-notifications": "~0.29.14",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-system-ui": "~4.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.19.13",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~18.3.12",
    "typescript": "^5.8.0"
  }
}
